# === Buffer credentials ===
# 1. Login ke https://buffer.com (free plan ok)
# 2. Connect channel X / Twitter di Buffer
# 3. Buka https://publish.buffer.com/developers/apps -> Create app
# 4. Generate "Access Token" untuk akun kamu sendiri (single-user token)
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# Profile ID untuk channel X / Twitter kamu di Buffer.
# Jalanin: npm run buffer:profiles  -> copy ID channel X-mu ke sini.
BUFFER_PROFILE_ID=your_x_channel_profile_id_here

# === AI copywriter (Pollinations) ===
# Daftar di https://pollinations.ai dan ambil API key kamu.
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Model AI buat generate copy. Default "openai" (GPT-class).
# Pilihan lain (cek docs Pollinations): "openai", "mistral", "deepseek", dll.
POLLINATIONS_MODEL=openai

# === Behavior config ===
# Timezone untuk cron (default Asia/Jakarta = WIB)
TZ=Asia/Jakarta

# Maksimal post per hari (anti shadowban). Default 4.
# Buffer free plan max 10 queued posts/channel — 4/day = aman.
MAX_POSTS_PER_DAY=4

# Set ke "true" buat dry-run (generate tweet tapi gak ngirim ke Buffer).
DRY_RUN=false

# Mode posting Buffer:
#   "now"    -> Buffer publish ke X langsung saat cron tick (default, paling cocok prime time)
#   "queue"  -> masuk ke Buffer queue (Buffer yang nentuin jam berdasarkan posting schedule kamu)
BUFFER_MODE=now

# Style postingan:
#   "single"   -> 1 tweet single per slot (AI pilih style: pain_point / social_proof / trending / curiosity_gap / storytelling)
#   "best_buy" -> selalu thread "BEST BUY VERSI AKU…" + reply per produk
#   "mixed"    -> 75% single, 25% thread (default, paling natural)
POST_STYLE=mixed

# Jumlah produk yang masuk thread saat mode best_buy. Default 4.
BEST_BUY_COUNT=4
