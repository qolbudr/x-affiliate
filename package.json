{
  "name": "x-affiliate",
  "version": "1.1.0",
  "description": "Auto-posting Shopee affiliate to X via Buffer (free plan friendly).",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "post:once": "ts-node src/scripts/postOnce.ts",
    "buffer:profiles": "ts-node src/scripts/bufferProfiles.ts",
    "products:scrape": "ts-node src/scripts/scrapeProducts.ts && vercel --prod && git add . && git commit -m 'Update products' && git push",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "buffer",
    "x",
    "twitter",
    "shopee",
    "affiliate",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@vercel/node": "^5.8.17",
    "dotenv": "16.4.5",
    "node-cron": "3.0.3"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/node-cron": "3.0.11",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
